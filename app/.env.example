# The browser never calls this URL directly: it always uses the same-origin /api/rpc proxy (app/api/rpc/route.ts,
# lib/solana/connection.ts), which forwards an allowlisted set of methods to RPC_URL. This value is only the SSR
# fallback, the fallback for RPC_URL, and the explorer-link cluster hint. It is inlined in the client bundle,
# so never put a keyed URL here.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Server-only RPC: the /api/rpc proxy (all browser tx building/sending), jar reads, OG images, locked tips (/api/locks)
# and the Blink POST. Put a keyed RPC here (Helius, Triton, QuickNode): locked tips + fan deposits need getProgramAccounts.
# Falls back to NEXT_PUBLIC_RPC_URL.
# RPC_URL=
# Optional: absolute origin for OG/metadata/Blink URLs (falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=https://buymeashare.r4to.com
# Demo only: adds a "Demo" lock unit that locks for exactly N seconds (e.g. 120 for the demo video). Leave unset in production.
# NEXT_PUBLIC_DEMO_LOCK_SECONDS=120
# Optional overrides
# NEXT_PUBLIC_JUPITER_API_URL=https://lite-api.jup.ag
# TESSERA_API_URL=https://rest-api.tessera.pe/v1/public
# JUPITER_API_URL=https://lite-api.jup.ag
#
# Local fork testing (never real mainnet):
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# RPC_URL=http://127.0.0.1:8899
