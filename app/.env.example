# Client RPC (mainnet): the browser builds tip/claim/close txs with it. Public endpoint works but rate-limits; use Helius/Triton for demos.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Server-only RPC for jar reads, OG images, locked tips (/api/locks) and the Blink POST. Keeps a keyed URL out of the bundle.
# Locked tips + fan deposits need getProgramAccounts: use a keyed RPC (Helius, Triton, QuickNode). Falls back to NEXT_PUBLIC_RPC_URL.
# RPC_URL=
# Optional: absolute origin for OG/metadata/Blink URLs (falls back to VERCEL_URL, then http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=https://buymeashare.vercel.app
# Demo only: adds a "Demo" lock unit that locks for exactly N seconds (e.g. 120 for the demo video). Leave unset in production.
# NEXT_PUBLIC_DEMO_LOCK_SECONDS=120
# Optional overrides
# NEXT_PUBLIC_JUPITER_API_URL=https://lite-api.jup.ag
# TESSERA_API_URL=https://rest-api.tessera.pe/v1/public
# JUPITER_API_URL=https://lite-api.jup.ag
#
# Local fork testing (never real mainnet):
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# RPC_URL=http://127.0.0.1:8899
